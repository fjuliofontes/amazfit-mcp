ZEPP_EMAIL=your-zepp-account@example.com
ZEPP_PASSWORD=your-zepp-password

# Optional: country code for the web-app login (default "US"). Try your
# account's real country if login fails.
# ZEPP_COUNTRY=US

# Optional: IANA timezone for dates/times (default: this machine's local zone).
# ZEPP_TIMEZONE=Europe/Lisbon

# Optional: name devices the built-in table doesn't know. deviceSource ids
# come from get_devices. Format: id=name;id=name
# ZEPP_DEVICE_NAMES=1234567=Amazfit Something

# Optional: where the login token is cached (default
# ~/.cache/zepp-mcp/auth.json, chmod 600). "off" disables caching.
# ZEPP_TOKEN_CACHE=~/.cache/zepp-mcp/auth.json
